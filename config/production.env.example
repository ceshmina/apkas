# production 環境の設定。
# このファイルを `config/production.env` にコピーして実値を埋める。
# `config/production.env` は .gitignore によりコミットされない。

# --- AWS ---
# 操作対象の環境を決める named profile。
# SSO なので、期限が切れたら aws sso login --profile apkas-production.admin を実行する。
AWS_PROFILE=apkas-production.admin
AWS_REGION=ap-northeast-1

# --- 配信先（terraform apply 後に output から転記する）---
SITE_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=

# 独自ドメイン。CloudFront が払い出すドメインではなく output の site_url を転記する。
# デプロイ完了時の表示にしか使っていない。
#   SITE_URL=https://apkas.net
SITE_URL=
