.DS_Store

# Claude Code のローカル設定（権限の承認記録などが入る）
.claude/settings.local.json

# 環境ごとの設定。実値はコミットしない
config/*.env
!config/*.env.example
.env
.env.*

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# backend.hcl はバケット名にアカウント ID を含むため除外する
backend.hcl
!backend.hcl.example
crash.log
crash.*.log
