# このファイルを terraform.tfvars にコピーして実値を埋める。
# terraform.tfvars は .gitignore によりコミットされない。

aws_region  = "ap-northeast-1"
aws_profile = "apkas-production.admin"

# production の AWS アカウント ID（12桁）。
# 公開リポジトリのため、この雛形には実値を書かない。
#   aws sts get-caller-identity --profile apkas-production.admin --query Account --output text
aws_account_id = "000000000000"
